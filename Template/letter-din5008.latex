% Pandoc LaTeX template for DIN 5008 Form B business letters (KOMA-Script scrlttr2)
$passoptions.latex()$
\documentclass[
  fontsize=11pt,
  paper=a4,
  DIN5008B,
  fromphone=false,
  fromfax=false
]{scrlttr2}
\usepackage[ngerman]{babel}
\usepackage{fontspec}
\usepackage{microtype}
\usepackage{hyperref}
\hypersetup{
  colorlinks=true,
  linkcolor=black,
  urlcolor=black,
  citecolor=black
}

$if(letter-fromname)$
\setkomavar{fromname}{$letter-fromname$}
$endif$
$if(letter-fromaddress)$
\setkomavar{fromaddress}{$for(letter-fromaddress)$$letter-fromaddress$\\$endfor$}
$endif$
$if(letter-place)$
\setkomavar{place}{$letter-place$}
$endif$
$if(letter-date)$
\setkomavar{date}{$letter-date$}
$endif$
$if(letter-yourref)$
\setkomavar{yourref}{$letter-yourref$}
$endif$
$if(letter-subject)$
\setkomavar{subject}{$letter-subject$}
$endif$
$if(letter-signature)$
\setkomavar{signature}{$letter-signature$}
$endif$

\begin{document}
\begin{letter}{%
$if(letter-to)$
$for(letter-to)$$letter-to$\\
$endfor$
$endif$
}
$if(letter-opening)$
\opening{$letter-opening$}
$else$
\opening{Sehr geehrte Damen und Herren,}
$endif$

$body$

$if(letter-closing)$
\closing{$letter-closing$}
$else$
\closing{Mit freundlichen Grüßen}
$endif$

\end{letter}
\end{document}
