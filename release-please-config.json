{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "include-component-in-tag": false,
  "include-v-in-tag": false,
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": false,
  "changelog-sections": [
    { "type": "feat", "section": "Funktionen" },
    { "type": "fix", "section": "Fehlerbehebungen" },
    { "type": "perf", "section": "Performance-Verbesserungen" },
    { "type": "docs", "section": "Dokumentation" },
    { "type": "refactor", "section": "Code-Refactoring" },
    { "type": "build", "section": "Build-System" },
    { "type": "ci", "section": "Continuous Integration" },
    { "type": "style", "section": "Stil" },
    { "type": "test", "section": "Tests" },
    { "type": "chore", "section": "Sonstiges", "hidden": false }
  ],
  "packages": {
    ".": {
      "package-name": "resume"
    }
  }
}
